# Never commit .env or actual keys. Loaded explicitly by --env-file .env.
# Copy this file to .env and fill in your values.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# TypeSafe API key. Obtain at https://console.typesafe.ai
TYPESAFE_API_KEY=

# ── EVALUATOR (optional) ──────────────────────────────────────────────────────
# Pin the Jev model. Default is jev-1.13.0 if unset.
JEV_MODEL=jev-1.13.0

# ── WORKER (choose one, or leave both blank) ──────────────────────────────────
# Without a worker the engine evaluates supplied candidates only; no AI
# generation or repair cycles run. Configure exactly one of the options below.

# Option A — Antigravity CLI (agy must be installed and on PATH, already signed in):
WORKER_COMMAND_JSON=["python","antigravity_worker.py"]
ANTIGRAVITY_MODEL=gemini-3.8-flash-low
# Optional: absolute path to the native agy executable if it is not on PATH.
# Prefer the native binary; .bat/.cmd launchers are not supported.
# ANTIGRAVITY_EXECUTABLE=C:\path\to\agy.exe

# Option B — Ollama (local, free; Ollama server must be running with the model already installed):
# OLLAMA_MODEL=llama3
# OLLAMA_URL=http://localhost:11434

# Option C — Custom command worker (reads JSON from stdin, writes candidate text to stdout):
# WORKER_COMMAND_JSON=["python","my_worker.py"]
